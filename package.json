{
  "name": "my-project",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "description": "Starter template for TypeScript projects",
  "prettier": "@my-project/configs/prettier",
  "scripts": {
    "build": "turbo run build",
    "build:watch": "turbo watch build",
    "clean": "pnpm -r --if-present run clean",
    "start:server": "pnpm --filter @my-project/server run start",
    "start:client": "pnpm --filter @my-project/client run start",
    "dev": "pnpm -r --if-present run dev",
    "test": "turbo run test",
    "test:watch": "pnpm -r --if-present run test:watch",
    "test:coverage": "pnpm -r --if-present run test:coverage",
    "lint": "pnpm run lint:root && turbo run lint",
    "lint:fix": "pnpm run lint:root --fix && turbo run lint:fix",
    "lint:root": "eslint --no-error-on-unmatched-pattern \"*.{ts,mts}\"",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "pnpm run typecheck:configs && turbo run typecheck",
    "typecheck:configs": "tsc --noEmit -p .",
    "typecheck:affected": "turbo run typecheck --filter='...[HEAD]'",
    "check": "pnpm run typecheck:configs && pnpm run lint:root && turbo run lint typecheck test build && pnpm run format",
    "check:affected": "turbo run lint typecheck test build --filter='...[HEAD]'",
    "audit": "pnpm -r --if-present run audit",
    "audit:fix": "pnpm -r --if-present run audit:fix",
    "audit:fix-force": "pnpm -r --if-present run audit:fix-force",
    "prepare": "husky"
  },
  "author": "Michael Martin",
  "license": "MIT",
  "devDependencies": {
    "@my-project/configs": "workspace:*",
    "@trivago/prettier-plugin-sort-imports": "catalog:",
    "eslint": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "tsdown": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
